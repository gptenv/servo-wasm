{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "servo-wasm-workerd-smoke",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["../../../target/wasm32-unknown-unknown/production-stripped/servo_js_wasm.wasm"],
      "fallthrough": true
    }
  ]
}
